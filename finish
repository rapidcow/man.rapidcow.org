#!/bin/sh
#
# finish -- give the built pages back their names
#
#   ./finish [-p] [dir]
#
# siteconf makes no file with a colon in its name, so the page of
# RdKw::WwW::GenLib is made as man/3/RdKw..WwW..GenLib.html (no
# Perl module name has `..' in it).  This links each such file under
# DIR/man (docs/man by default) to its real name, which is what the
# pages link to: RdKw::WwW::GenLib.html, .3pm and .3.
#
# Links, so that make(1) still finds what it made, and does not make
# it again.  With -p (for publishing), the `..' names go, as do the
# .ok markers that siteconf leaves in every directory.
#
set -e
prune=
if [ "$1" = -p ]; then prune=1; shift; fi
case $# in 0) dir=docs ;; 1) dir=$1 ;; *) echo "usage: $0 [-p] [dir]" >&2; exit 2 ;; esac
cd -- "$dir"

n=0
for f in man/*/*..*; do
	[ -f "$f" ] || continue
	base=${f##*/}
	case $base in
	*..*.*) ;;
	*) continue ;;
	esac
	# RdKw..WwW..GenLib.html: every `..' but in the suffix
	stem=${base%.*} ext=${base##*.}
	name=$(printf '%s\n' "$stem" | sed 's/\.\./::/g').$ext
	to=${f%/*}/$name
	if [ -n "$prune" ]; then
		mv -f -- "$f" "$to"
	else
		ln -f -- "$f" "$to"
	fi
	n=$((n + 1))
done
[ -n "$prune" ] && find . -name .ok -type f -exec rm -f {} +
echo "finish: $n file(s) in $dir/man named with ::" >&2
